# Copy to .env and replace every placeholder with local values.
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/DATABASE?schema=public"
JWT_SECRET="replace-with-a-long-random-secret"
SEED_ADMIN_PASSWORD="replace-with-a-unique-password"
SEED_STOCK_MANAGER_PASSWORD="replace-with-a-unique-password"
SEED_VIEWER_PASSWORD="replace-with-a-unique-password"